{
  "id": "ember-index",
  "name": "Oxide Memory",
  "mode": "dark",
  "license": "CC0-1.0 original repository-authored theme",
  "palette": {
    "background": "#120d0b",
    "surface": "#201512",
    "surfaceAlt": "#34221b",
    "text": "#ead8c4",
    "muted": "#9c7460",
    "accent": "#c36e4d",
    "accentAlt": "#8e513c",
    "border": "#432b23",
    "warning": "#d39a59",
    "error": "#c85c5c",
    "success": "#81936f"
  },
  "fonts": { "ui": "IBM Plex Sans", "display": "IBM Plex Serif", "mono": "IBM Plex Mono", "size": 11 },
  "icons": { "iconTheme": "Papirus-Dark", "cursorTheme": "Bibata-Modern-Ice" },
  "gtk": { "theme": "Adwaita-dark", "preferDark": true },
  "qt": { "style": "kvantum", "colorScheme": "dark" },
  "terminal": { "background": "#120d0b", "foreground": "#ead8c4", "accent": "#c36e4d" },
  "tmux": { "statusBg": "#201512", "statusFg": "#ead8c4", "accent": "#c36e4d" },
  "neovim": { "flavor": "dark", "accent": "#c36e4d" },
  "hyprland": { "activeBorder": ["#c36e4d", "#8e513c"], "inactiveBorder": "#432b23", "rounding": 7, "blur": true },
  "quickshell": { "radius": 8, "opacity": 0.91, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "durationMs": 190 },
  "lock": { "background": "#120d0b", "text": "#ead8c4" },
  "greeter": { "background": "#120d0b", "text": "#ead8c4" },
  "plymouth": { "top": "#120d0b", "bottom": "#201512", "text": "#ead8c4" },
  "wallpaper": { "path": "desktop/wallpapers/ember-index.svg", "license": "CC0-1.0", "author": "Infinity OS contributors", "title": "Oxide Memory" }
}
