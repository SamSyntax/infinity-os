{
  "id": "nocturne",
  "name": "Cold Carrier",
  "mode": "dark",
  "license": "CC0-1.0 original repository-authored theme",
  "palette": {
    "background": "#070914",
    "surface": "#101522",
    "surfaceAlt": "#192033",
    "text": "#eef4ff",
    "muted": "#9aa8bd",
    "accent": "#7ea6c9",
    "accentAlt": "#6f879c",
    "border": "#2a3550",
    "warning": "#f2c572",
    "error": "#ff7d90",
    "success": "#92dfb2"
  },
  "fonts": { "ui": "IBM Plex Sans", "display": "IBM Plex Serif", "mono": "IBM Plex Mono", "size": 11 },
  "icons": { "iconTheme": "Papirus-Dark", "cursorTheme": "Bibata-Modern-Ice" },
  "gtk": { "theme": "Adwaita-dark", "preferDark": true },
  "qt": { "style": "kvantum", "colorScheme": "dark" },
  "terminal": { "background": "#070914", "foreground": "#eef4ff", "accent": "#7ea6c9" },
  "tmux": { "statusBg": "#101522", "statusFg": "#eef4ff", "accent": "#7ea6c9" },
  "neovim": { "flavor": "dark", "accent": "#7ea6c9" },
  "hyprland": { "activeBorder": ["#7ea6c9", "#6f879c"], "inactiveBorder": "#2a3550", "rounding": 12, "blur": true },
  "quickshell": { "radius": 14, "opacity": 0.86, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "durationMs": 180 },
  "lock": { "background": "#070914", "text": "#eef4ff" },
  "greeter": { "background": "#070914", "text": "#eef4ff" },
  "plymouth": { "top": "#05080f", "bottom": "#141724", "text": "#eef4ff" },
  "wallpaper": { "path": "desktop/wallpapers/nocturne.svg", "license": "CC0-1.0", "author": "Infinity OS contributors", "title": "Cold Carrier" }
