{
  "id": "verdigris-ledger",
  "name": "Mineral Proof",
  "mode": "dark",
  "license": "CC0-1.0 original repository-authored theme",
  "palette": {
    "background": "#07110e",
    "surface": "#101d18",
    "surfaceAlt": "#1a3028",
    "text": "#dce5db",
    "muted": "#779284",
    "accent": "#6f9a84",
    "accentAlt": "#c39568",
    "border": "#254038",
    "warning": "#c39568",
    "error": "#b96868",
    "success": "#84ad8d"
  },
  "fonts": { "ui": "IBM Plex Sans", "display": "IBM Plex Serif", "mono": "IBM Plex Mono", "size": 11 },
  "icons": { "iconTheme": "Papirus-Dark", "cursorTheme": "Bibata-Modern-Ice" },
  "gtk": { "theme": "Adwaita-dark", "preferDark": true },
  "qt": { "style": "kvantum", "colorScheme": "dark" },
  "terminal": { "background": "#07110e", "foreground": "#dce5db", "accent": "#6f9a84" },
  "tmux": { "statusBg": "#101d18", "statusFg": "#dce5db", "accent": "#6f9a84" },
