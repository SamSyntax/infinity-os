  "hyprland": { "activeBorder": ["#6f9a84", "#c39568"], "inactiveBorder": "#254038", "rounding": 6, "blur": true },
  "quickshell": { "radius": 7, "opacity": 0.90, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "durationMs": 200 },
  "lock": { "background": "#07110e", "text": "#dce5db" },
  "greeter": { "background": "#07110e", "text": "#dce5db" },
  "plymouth": { "top": "#07110e", "bottom": "#101d18", "text": "#dce5db" },
  "wallpaper": { "path": "desktop/wallpapers/verdigris-ledger.svg", "license": "CC0-1.0", "author": "Infinity OS contributors", "title": "Mineral Proof" }
