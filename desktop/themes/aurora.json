{
  "id": "aurora",
  "name": "Paper Frequency",
  "mode": "light",
  "license": "CC0-1.0 original repository-authored theme",
  "palette": {
    "background": "#eee7d8",
    "surface": "#f8f2e6",
    "surfaceAlt": "#ddd2be",
    "text": "#28251f",
    "muted": "#8a745f",
    "accent": "#a35f43",
    "accentAlt": "#786b5b",
    "border": "#cfc4af",
    "warning": "#9b691f",
    "error": "#a43f43",
    "success": "#52785c"
  },
  "fonts": { "ui": "IBM Plex Sans", "display": "IBM Plex Serif", "mono": "IBM Plex Mono", "size": 11 },
  "icons": { "iconTheme": "Papirus-Light", "cursorTheme": "Bibata-Modern-Classic" },
  "gtk": { "theme": "Adwaita", "preferDark": false },
  "qt": { "style": "kvantum", "colorScheme": "light" },
  "terminal": { "background": "#f8f2e6", "foreground": "#28251f", "accent": "#a35f43" },
  "tmux": { "statusBg": "#ddd2be", "statusFg": "#28251f", "accent": "#a35f43" },
  "neovim": { "flavor": "light", "accent": "#a35f43" },
  "hyprland": { "activeBorder": ["#a35f43", "#786b5b"], "inactiveBorder": "#cfc4af", "rounding": 8, "blur": true },
  "quickshell": { "radius": 14, "opacity": 0.90, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "durationMs": 180 },
  "lock": { "background": "#eee7d8", "text": "#28251f" },
  "greeter": { "background": "#eee7d8", "text": "#28251f" },
  "plymouth": { "top": "#eee7d8", "bottom": "#ddd2be", "text": "#28251f" },
  "wallpaper": { "path": "desktop/wallpapers/aurora.svg", "license": "CC0-1.0", "author": "Infinity OS contributors", "title": "Paper Frequency" }
}
