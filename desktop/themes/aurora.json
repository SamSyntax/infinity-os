{
  "id": "aurora",
  "name": "Aurora Margin",
  "mode": "light",
  "license": "CC0-1.0 original repository-authored theme",
  "palette": {
    "background": "#f7f4ec",
    "surface": "#fffaf0",
    "surfaceAlt": "#ebe3d3",
    "text": "#20242a",
    "muted": "#667080",
    "accent": "#627fa4",
    "accentAlt": "#7e8d9d",
    "border": "#d6cdbd",
    "warning": "#a96f14",
    "error": "#b8455a",
    "success": "#3f8b63"
  },
  "fonts": { "ui": "IBM Plex Sans", "display": "IBM Plex Serif", "mono": "IBM Plex Mono", "size": 11 },
  "icons": { "iconTheme": "Papirus-Light", "cursorTheme": "Bibata-Modern-Classic" },
  "gtk": { "theme": "Adwaita", "preferDark": false },
  "qt": { "style": "kvantum", "colorScheme": "light" },
  "terminal": { "background": "#fffaf0", "foreground": "#20242a", "accent": "#627fa4" },
  "tmux": { "statusBg": "#ebe3d3", "statusFg": "#20242a", "accent": "#627fa4" },
  "neovim": { "flavor": "light", "accent": "#627fa4" },
  "hyprland": { "activeBorder": ["#627fa4", "#7e8d9d"], "inactiveBorder": "#d6cdbd", "rounding": 12, "blur": true },
  "quickshell": { "radius": 14, "opacity": 0.90, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "durationMs": 180 },
  "lock": { "background": "#f7f4ec", "text": "#20242a" },
  "greeter": { "background": "#f7f4ec", "text": "#20242a" },
  "plymouth": { "top": "#f7f4ec", "bottom": "#ebe3d3", "text": "#20242a" },
  "wallpaper": { "path": "desktop/wallpapers/aurora.svg", "license": "CC0-1.0", "author": "Infinity OS contributors", "title": "Aurora Margin" }
}
