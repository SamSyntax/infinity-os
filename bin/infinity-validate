#!/usr/bin/python3
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
failures = []

def ok(name):
    print(f"ok: {name}")

def fail(name, message):
    failures.append(f"{name}: {message}")
    print(f"fail: {name}: {message}")

def run(name, cmd):
    env = os.environ | {"PYTHONDONTWRITEBYTECODE": "1"}
    result = subprocess.run(cmd, cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
    if result.returncode == 0:
        ok(name)
    else:
        fail(name, result.stdout.strip())

def shell_syntax():
    scripts = [REPO / "install.sh", REPO / "launch-nested.sh", *sorted((REPO / "bin").glob("infinity-*")), REPO / "installation/lib/installer.sh", REPO / "desktop/greeter/start-greeter"]
    for script in scripts:
        if script.suffix == ".py":
            continue
        first = script.read_text(encoding="utf-8").splitlines()[0]
        if "bash" in first:
            run(f"shell syntax {script.relative_to(REPO)}", ["bash", "-n", str(script)])

def python_syntax():
    scripts = [
        *sorted((REPO / "bin").glob("infinity-*")),
        *sorted((REPO / "installation/lib").glob("*.py")),
        *sorted((REPO / "installation/stages").glob("*.py")),
    ]
    for script in scripts:
        first = script.read_text(encoding="utf-8").splitlines()[0]
        if "python3" in first:
            try:
                compile(script.read_text(encoding="utf-8"), str(script), "exec")
                ok(f"python syntax {script.relative_to(REPO)}")
            except SyntaxError as error:
                fail(f"python syntax {script.relative_to(REPO)}", str(error))

def lua_syntax():
    lua = shutil.which("luac") or shutil.which("lua")
    if not lua:
        print("skip: Lua syntax, no lua/luac interpreter present")
        return
    for path in sorted((REPO / "desktop/hypr").rglob("*.lua")):
        cmd = [lua, "-p", str(path)] if Path(lua).name == "luac" else [lua, "-e", "assert(loadfile(arg[1]))", str(path)]
        run(f"lua syntax {path.relative_to(REPO)}", cmd)

def package_manifests():
    seen = {}
    pattern = re.compile(r"^[a-z0-9][a-z0-9@._+-]*$")
    for path in sorted((REPO / "system/packages").glob("*.txt")):
        for line_no, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            item = line.split("#", 1)[0].strip()
            if not item:
                continue
            if not pattern.fullmatch(item):
                fail("package manifests", f"invalid package {item} at {path}:{line_no}")
            if item in seen:
                fail("package manifests", f"duplicate package {item} in {path} and {seen[item]}")
            seen[item] = path
    if not any(f.startswith("package manifests") for f in failures):
        ok("package manifests")

def preview_manifest():
    path = REPO / "installation/preview-packages.official.txt"
    required = {"hyprland", "quickshell", "ghostty", "hypridle", "hyprlock", "xdg-desktop-portal", "xdg-desktop-portal-hyprland", "xdg-desktop-portal-gtk", "qt6-wayland", "ttf-ibm-plex", "noto-fonts", "fuzzel"}
    pattern = re.compile(r"^[a-z0-9][a-z0-9@._+-]*$")
    packages = []
    for line_no, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        item = line.split("#", 1)[0].strip()
        if not item:
            continue
        if not pattern.fullmatch(item):
            fail("preview package manifest", f"invalid package {item} at {path}:{line_no}")
        packages.append(item)
    missing = required - set(packages)
    if missing:
        fail("preview package manifest", f"missing required packages: {sorted(missing)}")
    if len(packages) != len(set(packages)):
        fail("preview package manifest", "duplicate package token")
    if not any(f.startswith("preview package manifest") for f in failures):
        ok("preview package manifest")

def themes():
    schema = json.loads((REPO / "desktop/themes/schema.json").read_text(encoding="utf-8"))
    required = set(schema["required"])
    color_keys = set(schema["colorKeys"])
    nested = schema["nestedRequired"]
    color_fields = schema["colorFields"]
    hex_color = re.compile(r"^#[0-9a-fA-F]{6}$")
    for path in sorted((REPO / "desktop/themes").glob("*.json")):
        if path.name == "schema.json":
            continue
        data = json.loads(path.read_text(encoding="utf-8"))
        missing = required - data.keys()
        if missing:
            fail("themes", f"{path.name} missing {sorted(missing)}")
        if data.get("mode") not in schema["modes"]:
            fail("themes", f"{path.name} invalid mode")
        if color_keys - data.get("palette", {}).keys():
            fail("themes", f"{path.name} missing palette keys")
        for key, value in data.get("palette", {}).items():
            if key in color_keys and not isinstance(value, str):
                fail("themes", f"{path.name} palette {key} must be a string")
            if key in color_keys and isinstance(value, str) and not hex_color.match(value):
                fail("themes", f"{path.name} palette {key} must be #RRGGBB")
        for section, keys in nested.items():
            value = data.get(section)
            if not isinstance(value, dict):
                fail("themes", f"{path.name} section {section} must be an object")
                continue
            missing_nested = set(keys) - value.keys()
            if missing_nested:
                fail("themes", f"{path.name} section {section} missing {sorted(missing_nested)}")
        for section, keys in color_fields.items():
            value = data.get(section, {})
            if isinstance(value, dict):
                for key in keys:
                    color = value.get(key)
                    if not isinstance(color, str) or not hex_color.match(color):
                        fail("themes", f"{path.name} {section}.{key} must be #RRGGBB")
        active_border = data.get("hyprland", {}).get("activeBorder")
        if not isinstance(active_border, list) or len(active_border) != 2 or any(not isinstance(item, str) or not hex_color.match(item) for item in active_border):
            fail("themes", f"{path.name} hyprland.activeBorder must be two #RRGGBB colors")
        numeric_fields = [("fonts", "size"), ("hyprland", "rounding"), ("quickshell", "radius"), ("quickshell", "opacity"), ("quickshell", "durationMs")]
        for section, key in numeric_fields:
            if not isinstance(data.get(section, {}).get(key), (int, float)):
                fail("themes", f"{path.name} {section}.{key} must be numeric")
        bool_fields = [("gtk", "preferDark"), ("hyprland", "blur")]
        for section, key in bool_fields:
            if not isinstance(data.get(section, {}).get(key), bool):
                fail("themes", f"{path.name} {section}.{key} must be boolean")
        wallpaper = REPO / data["wallpaper"]["path"]
        if not wallpaper.exists():
            fail("themes", f"{path.name} wallpaper missing {wallpaper}")
        if not str(data["wallpaper"].get("path", "")).startswith("desktop/wallpapers/"):
            fail("themes", f"{path.name} wallpaper path must stay under desktop/wallpapers")
        for key in ["license", "author", "title"]:
            if not isinstance(data["wallpaper"].get(key), str) or not data["wallpaper"].get(key):
                fail("themes", f"{path.name} wallpaper {key} must be non-empty")
    if not any(f.startswith("themes") for f in failures):
        ok("themes")

def mappings():
    targets = set()
    for line_no, line in enumerate((REPO / "deployment/mappings.tsv").read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 4:
            fail("deployment mappings", f"line {line_no} must have 4 fields")
            continue
        src, target, mode, preserve = parts
        if not (REPO / src).exists():
            fail("deployment mappings", f"missing source {src}")
        if target in targets:
            fail("deployment mappings", f"duplicate target {target}")
        targets.add(target)
        if not re.fullmatch(r"0[0-7]{3}", mode):
            fail("deployment mappings", f"bad mode {mode}")
        if preserve not in {"yes", "no"}:
            fail("deployment mappings", f"bad preserve flag {preserve}")
        target_path = Path(target)
        if target_path.is_absolute() or ".." in target_path.parts:
            fail("deployment mappings", f"unsafe target path {target}")
        if target_path.parts and target_path.parts[0] not in {".config", ".local", "etc", "usr"}:
            fail("deployment mappings", f"target path is outside allowed roots: {target}")
        if target_path.parts and target_path.parts[0] == "usr" and target_path.parts[:2] != ("usr", "share"):
            fail("deployment mappings", f"only usr/share targets are allowed: {target}")
    if not any(f.startswith("deployment mappings") for f in failures):
        ok("deployment mappings")

def duplicate_bindings():
    path = REPO / "desktop/hypr/modules/bindings.lua"
    source = path.read_text(encoding="utf-8")
    keys = re.findall(r'o\.replace\("([^"]+)"', source)
    dupes = sorted(k for k in set(keys) if keys.count(k) > 1)
    if dupes:
        fail("duplicate keybindings", ", ".join(dupes))
    elif 'o.replace("SUPER + SHIFT + M", "Exit session", "hyprctl dispatch exit")' not in source:
        fail("duplicate keybindings", "missing exact Super+Shift+M exit binding")
    else:
        ok("duplicate keybindings")

def command_refs():
    allowed = {p.name for p in (REPO / "bin").glob("infinity-*")}
    packages = set()
    for path in (REPO / "system/packages").glob("*.txt"):
        for line in path.read_text(encoding="utf-8").splitlines():
            item = line.split("#", 1)[0].strip()
            if item:
                packages.add(item)
    commands = {"ghostty", "uwsm", "nautilus", "lazydocker", "obsidian", "keepassxc", "xdg-open", "fuzzel", "cliphist", "wl-copy", "quickshell", "hyprctl", "hypridle", "systemctl", "dbus-update-activation-environment", "loginctl", "systemd-run", "wpctl", "regreet", "cage"}
    provided = {"uwsm", "xdg-open", "systemctl", "dbus-update-activation-environment", "hyprctl", "wl-copy", "loginctl", "systemd-run", "wpctl"}
    if "greetd-regreet" in packages:
        provided.add("regreet")
    missing = sorted((commands - packages - allowed) - provided)
    if missing:
        fail("command references", f"not covered by manifests or allowlist: {missing}")
    else:
        ok("command references")

def shader_assets():
    shader_dir = REPO / "desktop/quickshell/shaders"
    sources = sorted(shader_dir.glob("*.frag"))
    compiled = sorted(shader_dir.glob("*.frag.qsb"))
    expected_compiled = {Path(f"{source}.qsb") for source in sources}
    shader_failed = False

    if not sources:
        fail("Qt shader assets", "no fragment shader sources found")
        return
    if set(compiled) != expected_compiled:
        missing = sorted(str(path.relative_to(REPO)) for path in expected_compiled - set(compiled))
        unexpected = sorted(str(path.relative_to(REPO)) for path in set(compiled) - expected_compiled)
        fail("Qt shader assets", f"source/compiled pairs differ; missing={missing}, unexpected={unexpected}")
        shader_failed = True

    for source in sources:
        text = source.read_text(encoding="utf-8")
        for required in ["#version 440", "layout(location = 0) in vec2 qt_TexCoord0", "layout(std140, binding = 0) uniform buf", "mat4 qt_Matrix", "float qt_Opacity"]:
            if required not in text:
                fail("Qt shader assets", f"{source.relative_to(REPO)} omitted {required}")
                shader_failed = True

    qsb = Path("/usr/lib/qt6/bin/qsb")
    if not qsb.is_file():
        discovered_qsb = shutil.which("qsb")
        qsb = Path(discovered_qsb) if discovered_qsb else Path()
    if not qsb.is_file():
        fail("Qt shader assets", "qsb is required to verify compiled shader reflection and deterministic output")
        shader_failed = True
    elif set(compiled) == expected_compiled:
        with tempfile.TemporaryDirectory(prefix="infinity-qsb-") as tmp:
            for source in sources:
                asset = Path(f"{source}.qsb")
                rebuilt = Path(tmp) / asset.name
                bake = subprocess.run([str(qsb), "--qt6", "-o", str(rebuilt), str(source)], cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
                if bake.returncode != 0:
                    fail("Qt shader assets", f"failed to rebuild {source.relative_to(REPO)}: {bake.stdout.strip()}")
                    shader_failed = True
                    continue
                if rebuilt.read_bytes() != asset.read_bytes():
                    fail("Qt shader assets", f"{asset.relative_to(REPO)} is stale or was baked with different qsb options")
                    shader_failed = True
                inspection = subprocess.run([str(qsb), "-d", str(asset)], cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
                if inspection.returncode != 0 or "Stage: Fragment" not in inspection.stdout or '"binding": 0' not in inspection.stdout:
                    fail("Qt shader assets", f"invalid reflection metadata in {asset.relative_to(REPO)}")
                    shader_failed = True

    if not shader_failed:
        ok("Qt shader assets")

def qml_hook():
    required = {
        "services/Theme.qml",
        "services/ShellState.qml",
        "services/Wallpaper.qml",
        "services/Workspaces.qml",
        "services/SystemResources.qml",
        "services/Network.qml",
        "services/Power.qml",
        "services/Audio.qml",
        "services/RailGeometry.qml",
        "components/ArchiveBlackHole.qml",
        "components/EnergyConnector.qml",
        "components/ThemeCard.qml",
        "surfaces/WallpaperSurface.qml",
        "surfaces/RailSurface.qml",
        "surfaces/ControlSurface.qml",
        "surfaces/LauncherSurface.qml",
        "surfaces/OsdSurface.qml",
        "surfaces/AppearanceSurface.qml",
    }
    missing = sorted(path for path in required if not (REPO / "desktop/quickshell" / path).is_file())
    if missing:
        fail("QML architecture", f"missing required files: {missing}")
    elif "Non-visual placeholder" in (REPO / "desktop/quickshell/shell.qml").read_text(encoding="utf-8"):
        fail("QML architecture", "shell.qml is still a placeholder")
    else:
        ok("QML architecture")
    qmlformat = shutil.which("qmlformat")
    if not qmlformat:
        print("skip: QML static check, qmlformat not present")
        return
    for path in sorted((REPO / "desktop").rglob("*.qml")):
        run(f"qml format check {path.relative_to(REPO)}", [qmlformat, "-n", str(path)])

def hyprland_theme_bridge():
    hyprland = (REPO / "desktop/hypr/hyprland.lua").read_text(encoding="utf-8")
    bridge_path = REPO / "desktop/hypr/modules/theme.lua"
    bridge = bridge_path.read_text(encoding="utf-8") if bridge_path.is_file() else ""
    theme_source = (REPO / "bin/infinity-theme").read_text(encoding="utf-8")
    if 'require("modules.decoration")\nrequire("modules.theme")' not in hyprland:
        fail("Hyprland theme bridge", "hyprland.lua must load modules.theme after decoration")
    if 'require("modules.theme")\nrequire("modules.animations")' not in hyprland:
        fail("Hyprland theme bridge", "modules.theme must load before later modules and user overrides")
    if "generated-theme.lua" not in bridge:
        fail("Hyprland theme bridge", "bridge must reference generated-theme.lua")
    if ".config/hypr/generated-theme.lua" not in theme_source or ".config/hypr/generated-theme.conf" in theme_source:
        fail("Hyprland theme bridge", "theme renderer must emit Lua and not the old .conf path")
    rendered = subprocess.run([sys.executable, str(REPO / "bin/infinity-theme"), "apply", "signal-archive", "--dry-run", "--target-user", "tester"], cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if rendered.returncode != 0 or "generated-theme.lua" not in rendered.stdout or "generated-theme.conf" in rendered.stdout:
        fail("Hyprland theme bridge", "dry-run output must include generated-theme.lua only")
    if not any(f.startswith("Hyprland theme bridge") for f in failures):
        ok("Hyprland theme bridge")

def installer_dry_run():
    with tempfile.TemporaryDirectory(prefix="infinity-validate-") as tmp:
        run("installer dry-run", [str(REPO / "install.sh"), "--plan", "--target-root", tmp, "--target-user", "testuser", "--stage", "preflight"])

def session_foundation():
    greetd = (REPO / "system/services/greetd.toml").read_text(encoding="utf-8")
    greeter_launcher = (REPO / "desktop/greeter/start-greeter").read_text(encoding="utf-8")
    greeter_stage = (REPO / "installation/stages/greeter.py").read_text(encoding="utf-8")
    packages = (REPO / "system/packages/desktop-shell.official.txt").read_text(encoding="utf-8").splitlines()
    mappings = (REPO / "deployment/mappings.tsv").read_text(encoding="utf-8")
    if "initial_session" in greetd:
        fail("session foundation", "default greetd config must not enable an initial autologin session")
    if 'command = "cage -s -- /usr/lib/infinity-os/start-greeter"' not in greetd or "regreet" not in greeter_launcher or "cage" not in packages:
        fail("session foundation", "ReGreet must run inside the packaged Cage compositor")
    greeter_sources = (
        "desktop/greeter/regreet.toml",
        "desktop/greeter/regreet.css",
        "desktop/greeter/start-greeter",
        "desktop/greeter/shell.qml",
        "system/services/greetd.toml",
        "desktop/wallpapers/nocturne.svg",
    )
    if any(source in mappings for source in greeter_sources):
        fail("session foundation", "greeter files must be owned only by the dedicated greeter stage")
    if any(source not in greeter_stage for source in greeter_sources):
        fail("session foundation", "dedicated greeter stage omits a required greeter source")
    boot = (REPO / "system/boot/infinity.conf").read_text(encoding="utf-8")
    if "@ROOT_UUID@" not in boot or "@MICROCODE_IMAGE@" not in boot:
        fail("session foundation", "boot template must expose root UUID and CPU microcode placeholders")
    if not any(item.startswith("session foundation") for item in failures):
        ok("session foundation")

def repository_tests():
    for path in sorted((REPO / "tests").glob("test_*.py")):
        run(f"test {path.relative_to(REPO)}", [sys.executable, str(path)])

def main():
    shell_syntax()
    python_syntax()
    lua_syntax()
    package_manifests()
    preview_manifest()
    themes()
    mappings()
    duplicate_bindings()
    command_refs()
    shader_assets()
    qml_hook()
    hyprland_theme_bridge()
    installer_dry_run()
    session_foundation()
    repository_tests()
    if failures:
        print("\n".join(failures), file=sys.stderr)
        raise SystemExit(1)

if __name__ == "__main__":
    main()
