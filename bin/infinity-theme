#!/usr/bin/env python3
import argparse
import json
import os
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "installation/lib"))
from safe_fs import atomic_write, read_regular, remove_regular, resolve_root, target_identity, validate_relative, validate_user

THEMES = REPO / "desktop/themes"
THEME_ID = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")


def load_theme(theme_id):
    if not THEME_ID.fullmatch(theme_id):
        raise SystemExit(f"invalid theme id: {theme_id!r}")
    path = THEMES / f"{theme_id}.json"
    if not path.is_file() or path.is_symlink():
        raise SystemExit(f"unknown theme: {theme_id}")
    return json.loads(path.read_text(encoding="utf-8"))


def theme_files():
    return sorted(path for path in THEMES.glob("*.json") if path.name != "schema.json" and not path.is_symlink())


def command_list(_args):
    for path in theme_files():
        theme = json.loads(path.read_text(encoding="utf-8"))
        print(f"{theme['id']}\t{theme['mode']}\t{theme['name']}")


def command_preview(args):
    theme = load_theme(args.theme)
    print(json.dumps({"id": theme["id"], "name": theme["name"], "mode": theme["mode"], "palette": theme["palette"], "wallpaper": theme["wallpaper"]}, indent=2, sort_keys=True))


def render_files(theme):
    palette = theme["palette"]
    active = " ".join(theme["hyprland"]["activeBorder"])
    return {
        ".config/infinity-os/theme.json": json.dumps(theme, indent=2, sort_keys=True) + "\n",
        ".config/quickshell/generated/theme.json": json.dumps(theme["quickshell"] | {"palette": palette}, indent=2, sort_keys=True) + "\n",
        ".config/hypr/generated-theme.conf": f"$infinity_active_border = {active}\n$infinity_inactive_border = {theme['hyprland']['inactiveBorder']}\n",
        ".config/ghostty/themes/infinity.conf": f"background = {theme['terminal']['background']}\nforeground = {theme['terminal']['foreground']}\npalette = 4={theme['terminal']['accent']}\n",
        ".config/tmux/infinity-theme.conf": f"set -g status-bg '{theme['tmux']['statusBg']}'\nset -g status-fg '{theme['tmux']['statusFg']}'\n",
        ".config/nvim/lua/infinity_theme.lua": f"return {{ flavor = '{theme['neovim']['flavor']}', accent = '{theme['neovim']['accent']}' }}\n",
        ".local/share/infinity-os/current-theme": theme["id"] + "\n",
    }


def apply_transaction(root, home, files, owner, fail_after=None):
    snapshots = {destination: read_regular(root, destination) for destination in files}
    promoted = 0
    try:
        for destination, content in files.items():
            atomic_write(root, destination, content, 0o644, owner)
            promoted += 1
            if fail_after is not None and promoted >= fail_after:
                raise RuntimeError(f"test fault after {promoted} theme updates")
    except BaseException:
        for destination, snapshot in snapshots.items():
            if snapshot is None:
                remove_regular(root, destination)
            else:
                atomic_write(root, destination, snapshot[0], snapshot[1], owner)
        raise


def command_apply(args):
    theme = load_theme(args.theme)
    try:
        root = resolve_root(args.target_root)
        user = validate_user(args.target_user)
        owner = None if args.dry_run else target_identity(root, user)
        wallpaper_rel = validate_relative(theme["wallpaper"]["path"])
    except (OSError, KeyError, ValueError) as error:
        raise SystemExit(f"invalid theme target: {error}") from error
    home = root / "home" / user
    wallpaper_src = REPO / wallpaper_rel
    expected_wallpaper_root = REPO / "desktop/wallpapers"
    if not wallpaper_src.is_file() or wallpaper_src.is_symlink() or expected_wallpaper_root not in wallpaper_src.parents:
        raise SystemExit(f"unsafe or missing wallpaper: {wallpaper_rel}")
    rendered = render_files(theme)
    planned = {home / validate_relative(relative): data.encode() for relative, data in rendered.items()}
    wallpaper_destination = home / ".local/share/infinity-os/current-wallpaper.svg"
    planned[wallpaper_destination] = wallpaper_src.read_bytes()
    if args.dry_run:
        print(f"DRY-RUN apply theme {theme['id']} to {home}")
        for destination in sorted(planned):
            action = "copy" if destination == wallpaper_destination else "write"
            print(f"PLAN {action} {destination}")
        return
    try:
        apply_transaction(root, home, planned, owner, args.test_fail_after)
    except BaseException as error:
        raise SystemExit(f"theme apply failed and rollback completed: {error}") from error
    print(f"applied theme {theme['id']} to {home}")


def main():
    parser = argparse.ArgumentParser(prog="infinity-theme")
    sub = parser.add_subparsers(required=True)
    list_parser = sub.add_parser("list")
    list_parser.set_defaults(func=command_list)
    preview = sub.add_parser("preview")
    preview.add_argument("theme")
    preview.set_defaults(func=command_preview)
    apply = sub.add_parser("apply")
    apply.add_argument("theme")
    apply.add_argument("--dry-run", action="store_true")
    apply.add_argument("--target-root", default="/")
    apply.add_argument("--target-user", default=os.environ.get("USER", "user"))
    apply.add_argument("--test-fail-after", type=int, default=None, help=argparse.SUPPRESS)
    apply.set_defaults(func=command_apply)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
